spring:
  application:
    name: rest-server
  datasource:
    # 데이터베이스 연결 정보 (.env 파일에서 설정)
    url: ${DB_URL:jdbc:postgresql://localhost:5432/postgres}
    username: ${DB_USERNAME:postgres}
    password: ${DB_PASSWORD:postgres}
    driver-class-name: org.postgresql.Driver
    hikari:
      maximum-pool-size: ${DB_POOL_SIZE:10}
      minimum-idle: ${DB_MIN_IDLE:5}
      idle-timeout: ${DB_IDLE_TIMEOUT:30000}
      connection-timeout: ${DB_CONN_TIMEOUT:10000}
      max-lifetime: ${DB_MAX_LIFETIME:2000000}
  
server:
  port: ${APP_PORT:8080}

# Exposed ORM 설정
exposed:
  show-sql: ${EXPOSED_SHOW_SQL:false}

# OpenAPI 문서 설정
springdoc:
  api-docs:
    path: /api-docs
  swagger-ui:
    path: /swagger-ui.html
    enabled: true
    operations-sorter: method

# 로깅 설정
logging:
  level:
    root: ${LOG_LEVEL:INFO}
    yousang.rest: ${APP_LOG_LEVEL:INFO}
    org.springframework: ${SPRING_LOG_LEVEL:INFO}
    org.jetbrains.exposed: ${EXPOSED_LOG_LEVEL:INFO}
    org.hibernate: ${HIBERNATE_LOG_LEVEL:INFO}
    com.zaxxer.hikari: ${HIKARI_LOG_LEVEL:INFO}

# 애플리케이션 고유 설정
app:
  cors:
    allowed-origins: ${CORS_ALLOWED_ORIGINS:*}
    allowed-methods: ${CORS_ALLOWED_METHODS:*}
    allowed-headers: ${CORS_ALLOWED_HEADERS:*}
  api:
    base-path: ${API_BASE_PATH:/api/v1} 