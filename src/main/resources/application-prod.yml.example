spring:
  profiles: prod
  datasource:
    # 운영 환경에서는 .env 파일에 설정된 환경 변수 사용
    url: ${DB_URL}
    username: ${DB_USERNAME}
    password: ${DB_PASSWORD}
    hikari:
      maximum-pool-size: ${DB_POOL_SIZE:20}
      minimum-idle: ${DB_MIN_IDLE:10}
      connection-timeout: ${DB_CONN_TIMEOUT:20000}
  
server:
  port: ${APP_PORT:8080}
  tomcat:
    max-threads: ${TOMCAT_MAX_THREADS:200}
    min-spare-threads: ${TOMCAT_MIN_SPARE_THREADS:20}

# 로깅 설정
logging:
  level:
    root: ${LOG_LEVEL:WARN}
    yousang.rest: ${APP_LOG_LEVEL:INFO}
    org.springframework: ${SPRING_LOG_LEVEL:WARN}
    org.jetbrains.exposed: ${EXPOSED_LOG_LEVEL:WARN}
    org.hibernate: ${HIBERNATE_LOG_LEVEL:WARN}
    com.zaxxer.hikari: ${HIKARI_LOG_LEVEL:WARN}
  file:
    name: ${LOG_FILE_PATH:/var/log/rest-server/application.log}
  pattern:
    console: "%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n"
    file: "%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n"

# 애플리케이션 설정
app:
  cors:
    allowed-origins: ${CORS_ALLOWED_ORIGINS:https://example.com}
  api:
    rate-limit:
      enabled: ${RATE_LIMIT_ENABLED:true}
      limit: ${RATE_LIMIT:100}
      duration: ${RATE_LIMIT_DURATION:60}  # 초 단위

# 메트릭 설정
management:
  endpoints:
    web:
      exposure:
        include: health,info,metrics,prometheus
  metrics:
    export:
      prometheus:
        enabled: true
  endpoint:
    health:
      show-details: when_authorized 