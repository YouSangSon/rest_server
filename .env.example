# Database Service Configuration
# Set to true to use Database Service instead of direct database connections
DATABASE_SERVICE_ENABLED=true
DATABASE_SERVICE_URL=http://localhost:8081

# Trading Bot API Keys
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# External Data APIs
NEWSAPI_KEY=your-newsapi-key-here

# Exchange API Keys
BINANCE_API_KEY=your-binance-api-key
BINANCE_SECRET_KEY=your-binance-secret-key
UPBIT_ACCESS_KEY=your-upbit-access-key
UPBIT_SECRET_KEY=your-upbit-secret-key

# OAuth2 Configuration (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret

# JWT Secret (Change this in production!)
JWT_SECRET=your-very-secure-secret-key-that-is-at-least-256-bits-long-for-production-use

# Database Direct Connection (used when DATABASE_SERVICE_ENABLED=false)
DB_URL=jdbc:postgresql://localhost:5432/rest_dev
DB_USERNAME=postgres
DB_PASSWORD=postgres

# MongoDB Direct Connection (used when DATABASE_SERVICE_ENABLED=false)
MONGODB_URI=mongodb://localhost:27017/rest_server

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ML Service
ML_SERVICE_URL=http://localhost:8000

# Application Settings
SPRING_PROFILES_ACTIVE=dev
LOG_LEVEL=INFO
APP_LOG_LEVEL=DEBUG
